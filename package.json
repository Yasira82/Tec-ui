{
  "name": "@yasser172/tec-ui",
  "version": "1.1.0",
  "description": "TEC Ecosystem — UI Components, Types, Constants, Utils & Payment helpers",
  "main":    "./dist/index.js",
  "module":  "./dist/index.mjs",
  "types":   "./dist/index.d.ts",
  "exports": {
    ".": {
      "import":  "./dist/index.mjs",
      "require": "./dist/index.js",
      "types":   "./dist/index.d.ts"
    },
    "./payment": {
      "import":  "./dist/payment/index.mjs",
      "require": "./dist/payment/index.js",
      "types":   "./dist/payment/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build":          "tsup",
    "dev":            "tsup --watch",
    "typecheck":      "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react":     ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react":     "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "tsup":             "^8.0.0",
    "typescript":       "^5.0.0"
  },
  "publishConfig": { "access": "public" }
}
